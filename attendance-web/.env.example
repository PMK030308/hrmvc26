# ============================================================================
# Biến môi trường frontend (attendance-web)
# Copy thành file .env.local khi dev, hoặc set trên Vercel: Project → Settings → Environment Variables
# Lưu ý: Vite CHỈ nhúng env lúc BUILD → set xong phải redeploy.
# ============================================================================

# BẮT BUỘC khi deploy production (Vercel):
# URL backend Render + hậu tố /api
# VD: https://hrm-attendance-api-xxxx.onrender.com/api
VITE_API_URL=

# Khi để trống (dev): baseURL mặc định '/api' → Vite proxy → http://localhost:4000
