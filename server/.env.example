# Biến môi trường backend (copy thành server/.env khi dev, hoặc set trên Render).
# File .env thật đã bị .gitignore loại trừ — KHÔNG commit key thật.

# Chatbot (trợ lý HRM) — bắt buộc để bật widget chatbot.
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini (tuỳ chọn). Mặc định: gemini-3.6-flash (hỗ trợ function calling).
# Các model flash khả dụng: gemini-3.6-flash, gemini-3.7-flash, gemini-flash-latest
# GEMINI_MODEL=gemini-3.6-flash

# JWT secret (tuỳ chọn, có default dev)
# JWT_SECRET=
# JWT_ACCESS_TTL=7d
# JWT_REFRESH_TTL=30d

# Production: exact HTTPS origins, comma-separated. Never use wildcard.
# CORS_ORIGINS=https://hr.example.com
# TRUST_PROXY=false
# If exactly one controlled reverse proxy overwrites X-Forwarded-For, use TRUST_PROXY=1.

# Development/test only. Production never returns reset tokens in an API response.
# PASSWORD_RESET_EXPOSE_TOKEN=false
# PASSWORD_RESET_DELIVERY_PROVIDER=webhook
# PASSWORD_RESET_WEBHOOK_URL=https://mailer.example.com/password-reset
# PASSWORD_RESET_WEBHOOK_BEARER_TOKEN=
# PASSWORD_RESET_PUBLIC_URL=https://hr.example.com/reset-password

# Production SQLite must be on a persistent volume with a verified backup/restore procedure.
# HRM_DB_PATH=/opt/render/project/src/data/hrm.db
# DATABASE_PERSISTENT_VOLUME=true
# DATABASE_BACKUP_CONFIRMED=true

# Retention runs in bounded batches after an initial delay; it never bulk-cleans on startup.
# RETENTION_SCHEDULER_ENABLED=true
# RETENTION_SCHEDULER_INITIAL_DELAY_MS=300000
# RETENTION_SCHEDULER_INTERVAL_MS=86400000
# RETENTION_SCHEDULER_BATCH_SIZE=100

# Port (mặc định 4000)
# PORT=4000

# URL frontend dùng trong QR của PDF đơn đã duyệt. Production bắt buộc HTTPS.
# APP_PUBLIC_URL=https://hr.example.com
# REQUEST_PDF_RATE_LIMIT_WINDOW_MS=60000
# REQUEST_PDF_RATE_LIMIT_MAX=20

# Attachment storage Phase 8. Production phải dùng đường dẫn tuyệt đối trên persistent volume có backup.
# ATTACHMENT_STORAGE_PROVIDER=local
# ATTACHMENT_STORAGE_ROOT=/srv/hrm/attachments
# ATTACHMENT_STORAGE_PERSISTENT_VOLUME=true
# ATTACHMENT_STORAGE_BACKUP_CONFIRMED=true
# ATTACHMENT_MAX_BYTES=5242880
# JSON_BODY_LIMIT=8mb
