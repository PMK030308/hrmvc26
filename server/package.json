{
  "name": "hrm-attendance-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "Backend HRM Chấm công — Express + SQLite",
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "attachments:backfill": "tsx src/scripts/attachmentStorageMaintenance.ts backfill",
    "attachments:cleanup": "tsx src/scripts/attachmentStorageMaintenance.ts cleanup",
    "retention:cleanup": "tsx src/scripts/retentionMaintenance.ts",
    "production:preflight": "tsx src/scripts/productionPreflight.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfmake": "^0.3.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
